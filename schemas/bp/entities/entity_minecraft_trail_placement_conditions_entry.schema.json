{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Entity Trail Placement Conditions Entry",
  "properties": {
    "block_types": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string",
                "default": ""
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string",
                "default": ""
              }
            }
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ],
      "description": "Block types that satisfy this condition at its vertical offset from the placement position."
    },
    "y_offset": {
      "title": "y Offset",
      "description": "Vertical offset from the trail block placement position. Defaults to 0.",
      "type": "integer",
      "minimum": -16,
      "maximum": 16,
      "default": 0
    }
  }
}