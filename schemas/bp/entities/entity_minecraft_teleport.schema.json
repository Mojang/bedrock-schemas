{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Entity Teleport",
  "description": "Defines an entity's teleporting behavior.",
  "properties": {
    "can_teleport_into_liquid": {
      "title": "Can Teleport Into Liquid",
      "description": "If set to true, the entity can teleport into blocks that contain liquids, such as water.",
      "type": "boolean",
      "default": false
    },
    "dark_teleport_chance": {
      "title": "Dark Teleport Chance",
      "description": "Modifies the chance that the entity will teleport if the entity is in darkness.",
      "type": "number",
      "default": 0.009999999776482582
    },
    "light_teleport_chance": {
      "title": "Light Teleport Chance",
      "description": "Modifies the chance that the entity will teleport if the entity is in daylight.",
      "type": "number",
      "default": 0.009999999776482582
    },
    "max_random_teleport_time": {
      "title": "Max Random Teleport Time",
      "description": "Maximum amount of time in seconds between random teleports.",
      "type": "number",
      "default": 20
    },
    "min_random_teleport_time": {
      "title": "Min Random Teleport Time",
      "description": "Minimum amount of time in seconds between random teleports.",
      "type": "number",
      "default": 0
    },
    "on_teleport_sound": {
      "title": "Teleport Sound",
      "description": "The level sound event which is played after a successful teleportation. Entities without a sound bound to this event play the default teleport sound.",
