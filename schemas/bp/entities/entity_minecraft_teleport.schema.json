    "projectile_filter": {
      "title": "Projectile Filter",
      "description": "Conditions that determine which projectiles cause the entity to attempt to teleport. If omitted, all projectiles cause a teleport attempt.",
      "type": "object"
    },
    "random_teleport_cube": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "description": "\n\nProperties:\n• x (float) = 0\n• y (float) = 0\n• z (float) = 0",
          "type": "object",
          "properties": {
            "x": {
              "title": "X",
              "type": "number",
              "default": 0
            },
            "y": {
              "title": "Y",
              "type": "number",
              "default": 0
            },
            "z": {
              "title": "Z",
              "type": "number",
              "default": 0
            }
          },
          "defaultSnippets": [
            {
              "label": "Random Teleport Cube (object)",
              "description": "Use Random Teleport Cube as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      ],
      "title": "Random Teleport Cube",
      "description": "Entity will teleport to a random position within the area defined by this cube.",
      "defaultSnippets": [
        {
          "label": "Random Teleport Cube (object)",
          "description": "Use Random Teleport Cube as an object",
          "body": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        }
      ]
    },
    "random_teleports": {
      "title": "Random Teleports",
      "description": "If true, the entity will teleport randomly.",
      "type": "boolean",
      "default": true
    },
    "target_distance": {
      "title": "Target Distance",
      "description": "Minimum distance the entity needs to be from the target to start teleporting towards it.",
      "type": "number",
      "default": 16
    },
    "target_teleport_chance": {
      "title": "Target Teleport Chance",
      "description": "The chance that the entity will teleport between 0.0 and 1.0. 1.0 means 100%.",
      "type": "number",
      "default": 1
    },
    "target_teleport_distance": {
      "title": "Target Teleport Distance",
      "description": "The minimum and maximum distance the entity can teleport toward the target. Negative values teleport away from the target. Values need to be between -32 and 32.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "$ref": "../../common/floatrange.schema.json"
        }
      ],
      "x-runtime-constraint-description": "Check that the limits imposed on the range (minimum, maximum and maximum distance between values) are respected"
    },
    "target_teleport_offset": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maximum": 32
        },
        {
          "description": "\n\nProperties:\n• x (float) = 0\n• y (float) = 0\n• z (float) = 0",
          "type": "object",
          "properties": {
            "x": {
              "title": "X",
              "type": "number",
              "default": 0
            },
            "y": {
              "title": "Y",
              "type": "number",
              "default": 0
            },
            "z": {
              "title": "Z",
              "type": "number",
              "default": 0
            }
          },
          "defaultSnippets": [
            {
              "label": "Target Teleport Offset (object)",
              "description": "Use Target Teleport Offset as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      ],
      "title": "Target Teleport Offset",
      "description": "The maximum random offset, on each axis and in either direction, added to the teleport directional vector. The y offset is rounded down to whole blocks. Values need to be between 0 and 32.",
      "defaultSnippets": [
        {
          "label": "Target Teleport Offset (object)",
          "description": "Use Target Teleport Offset as an object",
          "body": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        }
      ]
    },
    "teleports_on_projectile_hit": {
      "title": "Teleports On Projectile Hit",
      "description": "If true, the entity will attempt to teleport away from projectiles about to hit it.",
      "type": "boolean",
      "default": false
    }
  }
}